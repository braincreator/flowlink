{
  "client_name": "My FlowLink Relay",
  "client_email": "admin@example.com",
  "api_token": "relay-secret-token-here",
  "wss_addr": "0.0.0.0:8443",
  "http_addr": "0.0.0.0:8080",
  "tls": {
    "insecure": false,
    "cert_pinning": true,
    "ca_cert": "/etc/flowlink/ca.pem"
  },
  "llm": {
    "enabled": true,
    "backends": [
      {
        "name": "openai",
        "provider": "openai",
        "model": "gpt-4",
        "api_key": "sk-...",
        "base_url": "https://api.openai.com/v1"
      }
    ],
    "timeout_sec": 30
  },
  "billing": {
    "enabled": false,
    "currency": "RUB",
    "plans": []
  },
  "registry": {
    "data_path": "~/.flowlink/relay",
    "max_agents": 100
  }
}
